{
  "name": "camera-stream-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Windows Camera Agent: pulls camera config from the backend, runs FFmpeg (RTSP -> Agora RTMP), monitors and auto-restarts streams, captures screenshots",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pull-local-config": "tsx scripts/pullLocalConfig.ts",
    "viewer": "tsx scripts/viewer.ts",
    "service:install": "tsx scripts/service.ts install",
    "service:start": "tsx scripts/service.ts start",
    "service:stop": "tsx scripts/service.ts stop",
    "service:restart": "tsx scripts/service.ts restart",
    "service:uninstall": "tsx scripts/service.ts uninstall",
    "service:status": "tsx scripts/service.ts status",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "node-windows": "^1.0.0-beta.8",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "agora-rtc-sdk-ng": "^4.24.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

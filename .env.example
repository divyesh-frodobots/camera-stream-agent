# Windows Camera Agent environment configuration.
# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=production
LOG_LEVEL=info

# Backend reachable from the Windows PC (HTTPS in production).
# Unused when data/cameras.json is used (event operator / file mode).
BACKEND_URL=http://localhost:3000
# Optional fallback; the backend config response is authoritative.
AGENT_ID=
# One-time API key created on the backend (POST /api/agents). Stored only as a hash there.
# Optional when STREAM_URL is set (local stream mode does not call the config API).
# Unused when data/cameras.json is used (file mode ignores AGENT_API_KEY).
AGENT_API_KEY=

# Optional local stream override. When STREAM_URL is set the agent does not call
# GET /api/camera-agent/config — it streams this RTSP URL directly.
# RTMP_PUBLISH_URL is required in that mode (Agora ingest / publish URL).
# Unused when data/cameras.json is used (file mode publishers come from that file).
STREAM_URL=
RTMP_PUBLISH_URL=

# Shared Agora channel for local publishers. Default is offroad_cam_1.
# Stream keys must be minted for this channel. Leave blank to use the default.
AGORA_CHANNEL=offroad_cam_1
# File-mode control UI binds 127.0.0.1 only (default 3456).
AGORA_VIEWER_PORT=3456

# Encode target for file mode and STREAM_URL local stream (blank = default shown).
# Match the camera's real output: forcing a higher resolution or frame rate than
# the source delivers just wastes CPU and uplink. A phone acting as a camera
# usually needs 640x480 at 15 fps.
LOCAL_VIDEO_WIDTH=1920
LOCAL_VIDEO_HEIGHT=1080
LOCAL_VIDEO_FPS=25
LOCAL_VIDEO_BITRATE_KBPS=3000
# false remuxes with -c copy (no re-encode). Needs an H.264 source, and an AAC
# source too unless LOCAL_AUDIO_ENABLED=false.
LOCAL_VIDEO_TRANSCODE=true
LOCAL_AUDIO_ENABLED=true

# Path to ffmpeg.exe; "ffmpeg" uses PATH.
FFMPEG_PATH=ffmpeg

# Polling / intervals (seconds)
HEARTBEAT_INTERVAL_SECONDS=15
CONFIG_REFRESH_SECONDS=30
SCREENSHOT_INTERVAL_SECONDS=1
SCREENSHOT_DIR=./data/screenshots

# Restart policy (seconds)
RESTART_BASE_DELAY_SECONDS=5
RESTART_MAX_DELAY_SECONDS=60
# Reset the restart counter after the stream stays healthy this long
HEALTHY_RESET_SECONDS=300
# If no frames are produced within this window, kill+restart FFmpeg
FFMPEG_HEALTH_TIMEOUT_SECONDS=45
# Graceful shutdown timeout for FFmpeg before SIGKILL
FFMPEG_KILL_TIMEOUT_MS=10000
FFMPEG_START_TIMEOUT_MS=60000

# HTTP
REQUEST_TIMEOUT_MS=15000
HTTP_RETRY_BASE_MS=1000
HTTP_RETRY_MAX_MS=30000

# FFmpeg input tuning
RTSP_TIMEOUT_MICROS=15000000
FFMPEG_PROBESIZE=1000000
FFMPEG_ANALYZEDURATION=1000000